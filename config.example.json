{
  "_comment": "Example configuration. Copy to /app/config.json and edit before starting ds2api. Hot-reload via SIGHUP or fsnotify (if DS2API_HOT_RELOAD=true).",
  "server": {
    "listen": ":8080"
  },
  "auth": {
    "api_keys": [
      "your-api-key-1",
      "your-api-key-2"
    ]
  },
  "accounts": [
    {
      "name": "primary",
      "email": "user1@example.com",
      "password": "your-password-1"
    },
    {
      "name": "secondary",
      "email": "user2@example.com",
      "password": "your-password-2"
    }
  ],
  "model_aliases": {
    "gpt-4o": "deepseek-chat",
    "gpt-4o-mini": "deepseek-chat",
    "claude-3-5-sonnet": "deepseek-chat",
    "claude-3-opus": "deepseek-reasoner"
  },
  "current_input_file": {
    "enabled": true,
    "min_chars": 0
  },
  "thinking_injection": {
    "enabled": true
  },
  "responses": {
    "store_ttl_seconds": 900
  },
  "embeddings": {
    "provider": "deterministic"
  },
  "auto_delete": {
    "mode": "none"
  },
  "runtime": {
    "account_max_inflight": 2,
    "account_max_queue": 0,
    "global_max_inflight": 0,
    "pow_max_concurrency": 2,
    "token_refresh_interval_hours": 6
  }
}
